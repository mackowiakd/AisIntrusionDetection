<Window x:Class="AIS_networkTrafific.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AIS_networkTrafific"
        mc:Ignorable="d"
        Title="AIS NIDS Sandbox (Intrusion Detection System)" Height="700" Width="1100" Background="#F0F2F5" WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect Color="Gray" BlurRadius="5" ShadowDepth="1" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Dataset (ARFF):" VerticalAlignment="Center" FontWeight="SemiBold" Width="100"/>
                    <TextBox x:Name="TxtFilePath" Text="KDDTrain+_20Percent.arff" Width="400" VerticalContentAlignment="Center"/>
                    <Button Content="Przeglądaj..." Width="80" Margin="10,0,0,0" Click="BtnBrowse_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnLoadData" Content="Wczytaj i Przygotuj Dane" Width="180" Height="30" Click="BtnLoadData_Click"/>

                    <TextBlock Text="Train Size:" Margin="20,0,5,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtTrainSize" Text="5000" Width="60" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Test Size:" Margin="15,0,5,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtTestSize" Text="10000" Width="60" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Stan:" Margin="30,0,5,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtGlobalStatus" Text="Brak Danych" Foreground="Red" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <TabItem Header="Optymalizacja PCA" FontSize="14" FontWeight="SemiBold">
                <StackPanel Margin="0,10,0,0">

                    <Border Background="#E8F4F8" CornerRadius="8" Padding="15" Margin="5,0,5,15" BorderBrush="#007ACC" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Docelowa liczba wymiarów (K):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtPcaDim" Text="20" Width="50" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontWeight="Bold"/>

                            <Button x:Name="BtnApplyPca" Content="Zastosuj Kompresję PCA" Width="180" Height="30" Margin="20,0,0,0" Background="#007ACC" Foreground="White" FontWeight="Bold" Click="BtnApplyPca_Click"/>

                            <TextBlock Text="Status PCA:" Margin="30,0,5,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtPcaStatus" Text="Oczekuje" Foreground="Gray" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#F8F9FA" CornerRadius="6" Padding="10" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Wariant 1: V0 Basic PCA" FontWeight="Bold" Foreground="#6C757D" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                                <TextBlock Text="Liczba detektorów:" Margin="0,2"/>
                                <TextBox x:Name="TxtCountV0Pca" Text="5000" Margin="0,2,0,10"/>
                                <TextBlock Text="Statyczny promień:" Margin="0,2"/>
                                <TextBox x:Name="TxtRadiusV0Pca" Text="0.10" Margin="0,2,0,15"/>

                                <Button x:Name="BtnRunV0Pca" Content="Uruchom V0 Basic" Click="BtnRunV0Pca_Click" Background="#6C757D" Foreground="White" Height="30" FontWeight="SemiBold"/>

                                <Separator Margin="0,15,0,10"/>
                                <StackPanel x:Name="PanelResV0">
                                    <TextBlock Text="Wyniki klasyfikacji:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="TP (Ataki):" Margin="0,2"/>
                                            <TextBlock Text="FP (Fałszywe):" Margin="0,2"/>
                                            <TextBlock Text="Trafność (Acc):" Margin="0,2" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock x:Name="ResV0Pca_TP" Text="-" FontWeight="Bold" Margin="0,2"/>
                                            <TextBlock x:Name="ResV0Pca_FP" Text="-" FontWeight="Bold" Margin="0,2"/>
                                            <TextBlock x:Name="ResV0Pca_Acc" Text="-" FontWeight="Bold" Foreground="#6C757D" Margin="0,2"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#F8F9FA" CornerRadius="6" Padding="10" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Wariant 2: V2 Gravity PCA" FontWeight="Bold" Foreground="#DC3545" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                                <TextBlock Text="Liczba detektorów:" Margin="0,2"/>
                                <TextBox x:Name="TxtCountV2Pca" Text="5000" Margin="0,2,0,10"/>
                                <TextBlock Text="Minimal promień:" Margin="0,2"/>
                                <TextBox x:Name="TxtRadiusMinV2Pca" Text="0.10" Margin="0,2,0,15"/>

                                <Button x:Name="BtnRunV2Pca" Content="Uruchom V2 Gravity" Click="BtnRunV2Pca_Click" Background="#DC3545" Foreground="White" Height="30" FontWeight="SemiBold"/>

                                <Separator Margin="0,15,0,10"/>
                                <StackPanel x:Name="PanelResV2">
                                    <TextBlock Text="Wyniki klasyfikacji:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="TP (Ataki):" Margin="0,2"/>
                                            <TextBlock Text="FP (Fałszywe):" Margin="0,2"/>
                                            <TextBlock Text="Trafność (Acc):" Margin="0,2" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock x:Name="ResV2Pca_TP" Text="-" FontWeight="Bold" Margin="0,2"/>
                                            <TextBlock x:Name="ResV2Pca_FP" Text="-" FontWeight="Bold" Margin="0,2"/>
                                            <TextBlock x:Name="ResV2Pca_Acc" Text="-" FontWeight="Bold" Foreground="#DC3545" Margin="0,2"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#F1F8F5" BorderBrush="#A3CFBB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Wariant 3: V3 Uniform PCA" FontWeight="Bold" Foreground="#198754" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                                <TextBlock Text="Liczba detektorów:" Margin="0,2"/>
                                <TextBox x:Name="TxtCountV3Pca" Text="5000" Margin="0,2,0,10"/>
                                <TextBlock Text="Minimalny promień:" Margin="0,2"/>
                                <TextBox x:Name="TxtRadiusMinV3Pca" Text="0.10" Margin="0,2,0,15"/>

                                <Button x:Name="BtnRunV3Pca" Content="Uruchom V3 Uniform" Click="BtnRunV3Pca_Click" Background="#198754" Foreground="White" Height="30" FontWeight="SemiBold"/>

                                <Separator Margin="0,15,0,10"/>
                                <StackPanel x:Name="PanelResV3">
                                    <TextBlock Text="Wyniki klasyfikacji:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="TP (Ataki):" Margin="0,2"/>
                                            <TextBlock Text="FP (Fałszywe):" Margin="0,2"/>
                                            <TextBlock Text="Trafność (Acc):" Margin="0,2" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock x:Name="ResV3Pca_TP" Text="-" FontWeight="Bold" Margin="0,2"/>
                                            <TextBlock x:Name="ResV3Pca_FP" Text="-" FontWeight="Bold" Margin="0,2"/>
                                            <TextBlock x:Name="ResV3Pca_Acc" Text="-" FontWeight="Bold" Foreground="#198754" Margin="0,2"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Background="Transparent" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatusBar" Text="Gotowy." FontStyle="Italic" Foreground="Gray"/>
        </StatusBar>

    </Grid>
</Window>
